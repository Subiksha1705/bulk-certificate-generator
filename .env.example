# Database connection URL
# PostgreSQL format: postgresql+psycopg2://user:password@host:5432/dbname?sslmode=require
# SQLite format (for tests/local): sqlite:///./certificates.db
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/certificates_db

# Local storage directory for generated PDF files
STORAGE_DIR=./storage

# Base URL used for public verification endpoints and QR codes
PUBLIC_BASE_URL=http://localhost:8000

# Maximum number of recipients allowed per batch job (dev: 1000, prod: 500)
MAX_RECIPIENTS_PER_JOB=1000

# Resume unfinished jobs on application startup
RECOVER_ON_STARTUP=true

# Enable demo failure switch for testing failure isolation and retry
ENABLE_DEMO_FAILURES=false

# Artificial delay per certificate in milliseconds (dev/demo only)
SIMULATED_DELAY_MS=0

# Environment mode: dev | production
ENVIRONMENT=dev

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
